{
  "manifest_version": 3,
  "name": "Youtube 字幕全自動開關",
  "version": "0.5.1",
  "description": "依偏好自動選擇 YouTube 字幕，轉換台灣與香港用語，並可實驗性偵測影片內嵌字幕。",
  "permissions": [
    "activeTab",
    "identity",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://myapp.ahui3c.com/*"
  ],
  "background": {
    "scripts": [
      "src/build-info.js",
      "src/instance-coordinator.js",
      "src/platform.js",
      "src/background.js"
    ]
  },
  "icons": {
    "16": "icons/enabled-16.png",
    "32": "icons/enabled-32.png",
    "48": "icons/enabled-48.png",
    "128": "icons/store-128.png"
  },
  "action": {
    "default_title": "Youtube 字幕全自動開關：已開啟",
    "default_icon": {
      "16": "icons/enabled-16.png",
      "32": "icons/enabled-32.png"
    },
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "css": [
        "src/content.css"
      ],
      "js": [
        "src/build-info.js",
        "src/instance-coordinator.js",
        "src/platform.js",
        "src/core.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-subtitle-auto-switch@ahui3c.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "personallyIdentifyingInfo",
          "authenticationInfo",
          "browsingActivity"
        ]
      }
    }
  }
}
